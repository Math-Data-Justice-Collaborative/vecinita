{
  "name": "vecinita",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/frontend-*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "node scripts/prepare-husky.mjs",
    "test:frontend-i18n": "npm test -w vecinita-frontend-i18n",
    "test:frontend-ui": "npm test -w vecinita-frontend-ui",
    "build:ui-e2e": "bash scripts/ui/build_for_playwright.sh",
    "test:ui": "playwright test",
    "test:ui:staging": "playwright test --project=staging",
    "test:ui:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@vitest/coverage-v8": "^4.1.8",
    "husky": "^9.1.7"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "nanoid": "3.3.17",
    "postcss": "^8.5.18",
    "undici": "^7.28.0",
    "react-router": "7.18.2",
    "react-router-dom": "7.18.2",
    "minimatch@3": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@9": {
      "brace-expansion": "2.1.4"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.9"
    }
  },
  "dependencies": {
    "brace-expansion": "^5.0.9"
  }
}
