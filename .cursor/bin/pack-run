#!/usr/bin/env python3
"""Per-angle scriptable checks. Exit 0 PASS / 1 FAIL. Prints verdict=."""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

PHASE = os.environ.get("VERIFY_PHASE", "documenting")


def has_any(root: Path, names: tuple[str, ...]) -> bool:
    return any((root / name).exists() for name in names)


def docs_text(root: Path) -> str:
    docs = root / "docs"
    if not docs.is_dir():
        return ""
    chunks: list[str] = []
    for path in docs.rglob("*.md"):
        try:
            chunks.append(path.read_text(encoding="utf-8", errors="replace"))
        except OSError:
            continue
    return "\n".join(chunks).lower()


def run_make(root: Path, target: str) -> bool:
    makefile = root / "Makefile"
    if not makefile.is_file():
        return False
    proc = subprocess.run(
        ["make", "-C", str(root), target],
        check=False,
        capture_output=True,
        text=True,
    )
    return proc.returncode == 0


def finish(ok: bool, detail: str) -> int:
    verdict = "PASS" if ok else "FAIL"
    print(f"verdict={verdict} phase={PHASE} {detail}")
    return 0 if ok else 1


def check(pack: str, root: Path) -> int:
    text = docs_text(root)
    if pack == "lint-format-typecheck":
        if PHASE == "documenting":
            ok = "lint" in text or has_any(root, ("Makefile", "pyproject.toml", "package.json"))
            return finish(ok, "lint-bar-or-tooling-manifest")
        ok = run_make(root, "lint") if (root / "Makefile").is_file() else has_any(
            root, ("pyproject.toml", "package.json")
        )
        return finish(ok, "make-lint-or-manifest")
    if pack == "tests":
        if PHASE == "documenting":
            ok = "test" in text or has_any(root, ("Makefile", "pytest.ini", "package.json"))
            return finish(ok, "test-bar")
        if (root / "Makefile").is_file():
            return finish(run_make(root, "test") or run_make(root, "test-fast"), "make-test")
        return finish(has_any(root, ("pytest.ini", "package.json")), "test-manifest")
    if pack == "security":
        if PHASE == "documenting":
            ok = "security" in text or has_any(root, (".gitleaks.toml", "gitleaks.toml"))
            return finish(ok, "security-bar")
        return finish(True, "no-blocking-scanner-in-fixture")
    if pack == "pii":
        ok = "pii" in text or "privacy" in text or "retention" in text
        if PHASE == "documenting":
            return finish(ok or not has_any(root, ("docs/feature-list.md",)), "pii-policy-or-no-product")
        return finish(ok or True, "pii-implementing-advisory-pass-if-no-product-data")
    if pack == "contracts":
        ok = has_any(root, ("docs/api-contract.md",)) or "api" in text
        return finish(ok or not (root / "apps").exists(), "api-contract-or-no-apps")
    if pack == "qa-quality":
        ok = has_any(root, ("docs/test-plan.md",)) or "qa" in text or "coverage" in text
        return finish(ok, "qa-bar")
    if pack == "observability":
        ok = "observ" in text or "metric" in text or "log" in text or not has_any(
            root, ("docs/feature-list.md",)
        )
        return finish(ok, "observability-bar-or-not-a-service")
    if pack == "adr-raid":
        ok = has_any(root, ("docs/adr/README.md", "docs/decisions.md")) or "decision" in text
        return finish(ok, "decisions-logged")
    if pack == "milestones-planning":
        ok = has_any(root, ("docs/plan-card.md", "docs/roadmap.md")) or "plan" in text or "milestone" in text
        return finish(ok, "plan-present")
    if pack == "human-readable":
        # Fail if any docs H1 is only an opaque token like F12 or T1.1
        bad = False
        docs = root / "docs"
        if docs.is_dir():
            for path in docs.rglob("*.md"):
                for line in path.read_text(encoding="utf-8", errors="replace").splitlines()[:5]:
                    if line.startswith("# ") and line[2:].strip().isidentifier() and len(line.strip()) < 8:
                        bad = True
        return finish(not bad, "english-headings")
    if pack == "database-hygiene":
        touches_db = "postgres" in text or "migration" in text or (root / "migrations").exists()
        if not touches_db:
            return finish(True, "na-no-database")
        ok = (root / "migrations").exists() or "migration" in text
        return finish(ok, "migrations")
    if pack == "inline-documentation":
        if PHASE == "documenting":
            ok = (
                "inline-documentation" in text
                or "docstring" in text
                or "tsdoc" in text
                or has_any(root, ("docs/decisions/ev-025-inline-documentation-verify.md",))
            )
            return finish(ok, "inline-doc-bar-stated")
        bin_dir = Path(__file__).resolve().parent
        checker = bin_dir / "inline-doc-check.py"
        if not checker.is_file():
            return finish(False, "inline-doc-check-missing")
        proc = subprocess.run(
            [sys.executable, str(checker), str(root)],
            check=False,
            capture_output=True,
            text=True,
        )
        detail = (proc.stdout or proc.stderr or "").strip().replace("\n", " | ")[:500]
        return finish(proc.returncode == 0, detail or "inline-doc-scan")
    if pack == "skill-compliance":
        return check_skill_compliance(root, text)
    if pack == "cross-project-memory":
        return check_cross_project_memory(root, text)
    if pack == "extract-method":
        return check_extract_method(root, text)
    return finish(False, f"unknown-pack-{pack}")


def _session_path() -> Path | None:
    raw = os.environ.get("VERIFY_SESSION_PATH") or os.environ.get("EM_SESSION_PATH")
    if not raw:
        return None
    path = Path(raw).expanduser().resolve()
    return path if path.is_dir() else None


def check_skill_compliance(root: Path, text: str) -> int:
    """F76 — HANDOFF must cite memory-context when hooks wrote it."""
    duty = (
        "memory-context" in text
        and (
            "skill-compliance" in text
            or "f76" in text
            or "cite" in text
            or "handoff evidence" in text
        )
    ) or has_any(
        root,
        (
            "docs/decisions/ev-034-requirements-decisions.md",
            "docs/skill-integration.md",
        ),
    )
    if PHASE == "documenting":
        return finish(bool(duty), "cite-duty-stated")

    session = _session_path()
    if session is None:
        # No live session: require standing docs + pack handoff schema still present
        pack_handoff = Path(__file__).resolve().parent.parent / "docs" / "handoff-schema.md"
        schema_ok = False
        if pack_handoff.is_file():
            schema_ok = "memory-context" in pack_handoff.read_text(
                encoding="utf-8", errors="replace"
            ).lower()
        return finish(bool(duty and schema_ok), "cite-duty-docs-no-session")

    handoff = session / "HANDOFF.md"
    memory = session / "reports" / "memory-context.md"
    if not handoff.is_file():
        return finish(False, "handoff-missing")
    body = handoff.read_text(encoding="utf-8", errors="replace").lower()
    cited = "memory-context" in body or (
        "kg preflight" in body and ("skip" in body or "skipped" in body)
    )
    if memory.is_file() and not cited:
        return finish(False, "handoff-uncited-while-memory-context-exists")
    if not memory.is_file():
        # Hooks skipped: Evidence must still document skip
        skip_ok = "skip" in body or ("hooks" in body and "disabled" in body)
        return finish(skip_ok or cited, "memory-context-absent-need-skip-note")
    return finish(True, "handoff-cites-memory-context")


def check_cross_project_memory(root: Path, text: str) -> int:
    """F108–F109 — Neo4j cross-project checkpoint + dispositions."""
    duty = (
        "cross-project-memory" in text
        or "f107" in text
        or "f108" in text
        or "f109" in text
        or (
            "cross-project" in text
            and (
                "disposition" in text
                or ("adopt" in text and "waive" in text)
                or "keep-local" in text
                or "neo4j" in text
            )
        )
        or has_any(
            root,
            (
                "docs/decisions/ev-040-requirements-decisions.md",
                "docs/decisions/ev-040-tech-decisions.md",
            ),
        )
        or "cross-project neo4j checkpoint" in text
    )
    if PHASE == "documenting":
        return finish(bool(duty), "cross-project-duty-stated")

    session = _session_path()
    if session is None:
        pack_skills = Path(__file__).resolve().parent.parent / "spec-development" / "SKILL.md"
        skill_ok = False
        if pack_skills.is_file():
            st = pack_skills.read_text(encoding="utf-8", errors="replace").lower()
            skill_ok = "cross-project" in st and (
                "adopt" in st or "disposition" in st or "f107" in st
            )
        return finish(bool(duty and skill_ok), "cross-project-duty-docs-no-session")

    handoff = session / "HANDOFF.md"
    memory = session / "reports" / "memory-context.md"
    bodies: list[str] = []
    if handoff.is_file():
        bodies.append(handoff.read_text(encoding="utf-8", errors="replace").lower())
    for path in sorted((session / "reports").glob("*.md")) if (session / "reports").is_dir() else []:
        try:
            bodies.append(path.read_text(encoding="utf-8", errors="replace").lower())
        except OSError:
            continue
    joined = "\n".join(bodies)
    if not joined:
        return finish(False, "handoff-or-reports-missing")

    skip_ok = (
        ("skip" in joined and ("neo4j" in joined or "hook" in joined or "retrieve" in joined))
        or ("memory-context" in joined and "skipped" in joined)
        or ("kg preflight" in joined and "skip" in joined)
    )
    disposed = (
        ("adopt" in joined or "waive" in joined or "keep-local" in joined or "keep local" in joined)
        and (
            "cross-project" in joined
            or "pattern" in joined
            or "historical changes" in joined
            or "disposition" in joined
        )
    )
    if memory.is_file():
        mem = memory.read_text(encoding="utf-8", errors="replace").lower()
        if "skipped" in mem or ("skip" in mem and "fail-open" in mem):
            skip_ok = True
    if skip_ok or disposed:
        return finish(True, "cross-project-disposed-or-skip")
    return finish(False, "cross-project-undisposed")


def check_extract_method(root: Path, text: str) -> int:
    """F75 — refactor-safety bar stated; QA skill names failure modes."""
    bar = (
        "refactor" in text
        or "extract-method" in text
        or "f75" in text
        or "refactor-safety" in text
    )
    if PHASE == "documenting":
        return finish(bool(bar), "refactor-bar-stated")

    candidates = [
        root / ".cursor" / "skills" / "build" / "qa" / "SKILL.md",
        Path(__file__).resolve().parent.parent / "build" / "qa" / "SKILL.md",
    ]
    qa_text = ""
    for path in candidates:
        if path.is_file():
            qa_text = path.read_text(encoding="utf-8", errors="replace").lower()
            break
    modes = (
        "refactor" in qa_text
        and (
            "failure mode" in qa_text
            or "dead call" in qa_text
            or "characterization" in qa_text
            or "moved symbol" in qa_text
        )
    )
    return finish(bool(bar and modes), "qa-refactor-failure-modes")


def main() -> int:
    if len(sys.argv) < 2:
        print("usage: pack-run PACK_ID [ROOT]", file=sys.stderr)
        return 2
    pack = sys.argv[1]
    root = Path(sys.argv[2] if len(sys.argv) > 2 else os.environ.get("VERIFY_ROOT", ".")).resolve()
    return check(pack, root)


if __name__ == "__main__":
    raise SystemExit(main())
